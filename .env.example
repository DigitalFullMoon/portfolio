# ======================================
# CONFIGURATION BASE DE DONNÉES
# ======================================
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me


# ======================================
# CONFIGURATION FLASK
# ======================================
SECRET_KEY=change_me_with_random_string
FLASK_DEBUG=True
FLASK_ENV=development


# ======================================
# CONFIGURATION BREVO (Newsletter)
# ======================================
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=1


# ======================================
# CONFIGURATION GOOGLE reCAPTCHA
# ======================================
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key


# ======================================
# CONFIGURATION BASE DE DONNÉES (pour Flask)
# ======================================
DATABASE_URL=mysql+pymysql://portfolio_user:change_me@db:3306/portfolio_db